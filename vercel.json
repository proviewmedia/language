{
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/course", "destination": "/index.html" },
    { "source": "/practice", "destination": "/index.html" },
    { "source": "/progress", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/lesson/:track/:id", "destination": "/index.html" }
  ]
}
